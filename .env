# ============================================
# Go Admin 环境配置文件
# ============================================

# 应用配置
APP_NAME=admin-api
APP_PORT=9501
APP_DEBUG=true
APP_SECRET=admin-secret-key-2024

# 数据库配置
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=go_admin
DB_TABLE_PREFIX=admin_

# Redis 配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=123456
REDIS_DB=0

# JWT 配置
JWT_SECRET=admin-jwt-secret-key
JWT_EXPIRES=7200
JWT_REFRESH_EXPIRES=86400

# 日志配置
LOG_LEVEL=debug
LOG_CONSOLE=true
LOG_FILE=./data/logs/admin-api.log
